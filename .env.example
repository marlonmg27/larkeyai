# Plantilla de variables del frontend (larkeyai). Copia a .env y asigna los valores.
# En Lovable, defínelas en la configuración del proyecto y vuelve a publicar.

# Backend
BACKEND_URL=                      # URL https pública del backend (sin / final)
BACKEND_INTERNAL_SECRET=
BACKEND_ONBOARDING_ENABLED=
BACKEND_AUTH_ENABLED=
AUTH_JWT_SECRET=
SITE_URL=                         # URL pública de este frontend

# Chatwoot (si queda vacía se usa la de Railway)
VITE_CHATWOOT_FRONTEND_URL=https://chatwoot-production-7bbc.up.railway.app

# WhatsApp
WABA_ACCESS_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=

# Stripe (el webhook /api/public/stripe/webhook reenvía al backend)
STRIPE_SECRET_KEY=                # sk_live_... o sk_test_...
STRIPE_TEST_API_KEY=
STRIPE_WEBHOOK_SECRET=            # whsec_... del endpoint de este entorno

# Otros
LOVABLE_API_KEY=
APP_USER_CONNECTION_KEY_SECRET=

# Supabase (heredado de Lovable)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
